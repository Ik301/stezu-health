<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: install.sh fills in the three placeholders (interpreter, script, log folder) and
     writes the result to ~/Library/LaunchAgents/. The interpreter is the real binary, the file
     that holds Full Disk Access. Runs daily at 20:00 local time and once at load; a run missed
     while the Mac slept happens when it wakes. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ik301.stezu.screentime</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON__</string>
    <string>__SCRIPT__</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>20</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__LOG_DIR__/stezu-screentime.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/stezu-screentime.err.log</string>
</dict>
</plist>
