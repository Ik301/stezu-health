#!/usr/bin/env bash
# Test stub: writes StezuHealth.app with PlugIns/RestActivity.appex under -derivedDataPath, each
# with its own profile (the app's valid 7 days, the extension's FAKE_EXT_DAYS, default 7, for
# FAKE_EXT_APP_ID, default its own id). FAKE_NO_APPEX leaves the extension out; FAKE_BUILD_RC fails
# like a compile error.
echo "xcodebuild $* (cwd $PWD)" >>"$STUB_LOG"
dd=""
while [ $# -gt 0 ]; do
  if [ "$1" = -derivedDataPath ]; then dd="$2"; fi
  shift
done
if [ "${FAKE_BUILD_RC:-0}" != 0 ]; then
  echo "/clone/App/Sources/Home/HomeView.swift:3:1: error: cannot find 'Bar' in scope"
  echo "** BUILD FAILED **"
  exit "$FAKE_BUILD_RC"
fi
app="$dd/Build/Products/Debug-iphoneos/StezuHealth.app"
rm -rf "$app"
mkdir -p "$app"

# profile <bundle dir> <application-identifier> <days valid>
profile() {
  local expires
  expires="$(python3 -c 'import datetime as d, sys; print((d.datetime.now(d.timezone.utc) + d.timedelta(days=float(sys.argv[1]))).strftime("%Y-%m-%dT%H:%M:%SZ"))' "$3")"
  cat >"$1/embedded.mobileprovision" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<plist version="1.0"><dict>
<key>Name</key><string>iOS Team Provisioning Profile: ${2#*.}</string>
<key>ExpirationDate</key><date>$expires</date>
<key>Entitlements</key><dict><key>application-identifier</key><string>$2</string></dict>
</dict></plist>
EOF
}
profile "$app" ABCDE12345.com.ik301.stezuhealth 7
if [ -z "${FAKE_NO_APPEX:-}" ]; then
  mkdir -p "$app/PlugIns/RestActivity.appex"
  profile "$app/PlugIns/RestActivity.appex" "${FAKE_EXT_APP_ID:-ABCDE12345.com.ik301.stezuhealth.RestActivity}" "${FAKE_EXT_DAYS:-7}"
fi
echo "** BUILD SUCCEEDED **"
