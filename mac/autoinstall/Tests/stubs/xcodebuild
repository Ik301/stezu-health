#!/usr/bin/env bash
# Test stub: writes StezuHealth.app (with RestActivity.appex and a profile valid 7 days) under
# -derivedDataPath, or fails like a compile error when FAKE_BUILD_RC is set.
echo "xcodebuild $* (cwd $PWD)" >>"$STUB_LOG"
dd=""
while [ $# -gt 0 ]; do
  if [ "$1" = -derivedDataPath ]; then dd="$2"; fi
  shift
done
if [ "${FAKE_BUILD_RC:-0}" != 0 ]; then
  echo "/clone/App/Sources/Home/HomeView.swift:3:1: error: cannot find 'Bar' in scope"
  echo "** BUILD FAILED **"
  exit "$FAKE_BUILD_RC"
fi
app="$dd/Build/Products/Debug-iphoneos/StezuHealth.app"
mkdir -p "$app/PlugIns/RestActivity.appex"
expires="$(python3 -c 'import datetime as d; print((d.datetime.now(d.timezone.utc) + d.timedelta(days=7)).strftime("%Y-%m-%dT%H:%M:%SZ"))')"
cat >"$app/embedded.mobileprovision" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<plist version="1.0"><dict>
<key>ExpirationDate</key><date>$expires</date>
<key>Entitlements</key><dict><key>application-identifier</key><string>ABCDE12345.com.ik301.stezuhealth</string></dict>
</dict></plist>
EOF
echo "** BUILD SUCCEEDED **"
